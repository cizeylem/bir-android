<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- installreferrer-2.2 AAR manifest'inde de aynı izin var; bindService'te SecurityException'ı önler. -->
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" />

    <!--
      Android 11+ paket görünürlüğü. AAR'ın targetSdk'sı 22 olduğundan kendi manifest'inde <queries> yoktu;
      bizde var, çünkü görünürlük yoksa queryIntentServices boş döner ve referrer sessizce hiç okunmaz.
      Meta install referrer için katana/instagram/lite <package> girdileri; <provider> girdisi gerekmez.
    -->
    <queries>
        <package android:name="com.android.vending" />
        <!-- GAID: bindService hedefi com.google.android.gms. Google'ın kendi ads-identifier AAR'ı <queries>
             eklemiyor (belki GMS sistem tarafında özel muameleli), ama eksikse GAID SESSİZCE hiç okunmaz;
             fazlalığın maliyeti yok, eksiğin maliyeti sinyal kaybı. Araştırmada "tahmin" işaretli. -->
        <package android:name="com.google.android.gms" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.lite" />
        <intent>
            <action android:name="com.google.android.finsky.BIND_GET_INSTALL_REFERRER_SERVICE" />
        </intent>
    </queries>
</manifest>
